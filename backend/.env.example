SERVER_PORT=8080
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ironfit
DB_USER=root
DB_PASSWORD=replace-me
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-bytes
