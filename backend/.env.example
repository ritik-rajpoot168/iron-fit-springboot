IRONFIT_BRIDGE_SECRET=replace-with-the-same-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
# Optional: if absent or unavailable, deterministic local plan generation is used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
